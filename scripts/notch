#!/usr/bin/env zsh
set -euo pipefail

PORT="${MYNOTCH_PORT:-7777}"
TOKEN_FILE="${HOME}/.mynotch/token"
BASE_URL="http://127.0.0.1:${PORT}"

if [[ ! -r "$TOKEN_FILE" ]]; then
  echo "notch: token not found at $TOKEN_FILE (start MyNotchApp once first)" >&2
  exit 1
fi
TOKEN="$(<"$TOKEN_FILE")"
TOKEN="${TOKEN//$'\n'/}"

json_str() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\r'/}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\t'/\\t}"
  printf '"%s"' "$s"
}

post_json() {
  local endpoint="$1"
  local payload="$2"
  curl -fsS -X POST "${BASE_URL}${endpoint}" \
    -H "Authorization: Bearer ${TOKEN}" \
    -H "Content-Type: application/json" \
    -d "$payload"
  echo
}

cmd="${1:-}"
shift || true

case "$cmd" in
  health)
    curl -fsS "${BASE_URL}/health" -H "Authorization: Bearer ${TOKEN}"
    echo
    ;;
  toast)
    title="${1:?usage: notch toast <title> [--subtitle S] [--tint ok|fail|warn|info|neutral] [--symbol S] [--priority low|normal|high|critical] [--ttl SEC] [--key K] [--bundle-id ID] [--error-file PATH]}"
    shift
    subtitle="" tint="" symbol="" priority="" ttl="" key="" bundle_id="" error_file=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --subtitle)   subtitle="$2"; shift 2 ;;
        --tint)       tint="$2"; shift 2 ;;
        --symbol)     symbol="$2"; shift 2 ;;
        --priority)   priority="$2"; shift 2 ;;
        --ttl)        ttl="$2"; shift 2 ;;
        --key)        key="$2"; shift 2 ;;
        --bundle-id)  bundle_id="$2"; shift 2 ;;
        --error-file) error_file="$2"; shift 2 ;;
        *) echo "unknown flag: $1" >&2; exit 2 ;;
      esac
    done
    local -a fields
    fields+=("\"title\":$(json_str "$title")")
    [[ -n "$subtitle" ]] && fields+=("\"subtitle\":$(json_str "$subtitle")")
    [[ -n "$tint" ]] && fields+=("\"tint\":$(json_str "$tint")")
    [[ -n "$symbol" ]] && fields+=("\"symbol\":$(json_str "$symbol")")
    [[ -n "$priority" ]] && fields+=("\"priority\":$(json_str "$priority")")
    [[ -n "$key" ]] && fields+=("\"key\":$(json_str "$key")")
    [[ -n "$bundle_id" ]] && fields+=("\"bundleId\":$(json_str "$bundle_id")")
    [[ -n "$ttl" ]] && fields+=("\"ttl\":$ttl")
    if [[ -n "$error_file" && -r "$error_file" ]]; then
      local err_text
      err_text="$(tail -n 30 "$error_file")"
      [[ -n "$err_text" ]] && fields+=("\"errorLog\":$(json_str "$err_text")")
    fi
    post_json "/toast" "{${(j:,:)fields}}"
    ;;
  progress)
    key="${1:?usage: notch progress <key> <title> <0..1> [subtitle]}"
    title="${2:?}"
    value="${3:?}"
    subtitle="${4:-}"
    local -a fields
    fields+=("\"key\":$(json_str "$key")" "\"title\":$(json_str "$title")" "\"value\":$value")
    [[ -n "$subtitle" ]] && fields+=("\"subtitle\":$(json_str "$subtitle")")
    post_json "/progress" "{${(j:,:)fields}}"
    ;;
  activity)
    source="${1:?usage: notch activity <source> <session> <working|waiting|done|failed> [title] [cwd]}"
    session="${2:?}"
    state="${3:?}"
    title="${4:-}"
    cwd="${5:-}"
    local -a fields
    fields+=("\"source\":$(json_str "$source")" "\"session\":$(json_str "$session")" "\"state\":$(json_str "$state")")
    [[ -n "$title" ]] && fields+=("\"title\":$(json_str "$title")")
    [[ -n "$cwd" ]] && fields+=("\"cwd\":$(json_str "$cwd")")
    post_json "/activity" "{${(j:,:)fields}}"
    ;;
  logpin)
    target="${1:?usage: notch logpin <path|--cmd CMD> [--pattern REGEX]}"
    shift
    path="" command="" pattern=""
    if [[ "$target" == "--cmd" ]]; then
      command="${1:?missing command}"; shift
    else
      path="$target"
    fi
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --pattern) pattern="$2"; shift 2 ;;
        *) echo "unknown flag: $1" >&2; exit 2 ;;
      esac
    done
    local -a fields
    [[ -n "$path" ]] && fields+=("\"path\":$(json_str "$path")")
    [[ -n "$command" ]] && fields+=("\"command\":$(json_str "$command")")
    [[ -n "$pattern" ]] && fields+=("\"pattern\":$(json_str "$pattern")")
    post_json "/logpin" "{${(j:,:)fields}}"
    ;;
  unpin)
    post_json "/logpin" '{"action":"unpin"}'
    ;;
  *)
    echo "usage: notch <health|toast|progress|activity|logpin|unpin> ..." >&2
    exit 2
    ;;
esac
